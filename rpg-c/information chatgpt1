Sans complètement révolutionner ton code, tu pourrais arriver à :

public class Joueur
{
    private string pseudo;

    public int Vie { get; private set; }
    public int MaxVie { get; private set; }
    public int Force { get; private set; }
    public int Exp { get; private set; }
    public int LvlCapExp { get; private set; }
    public int Lvl { get; private set; }
    public int Potions { get; private set; }

    public Joueur(
        string pseudo,
        int vie,
        int force,
        int exp,
        int lvlCapExp,
        int lvl,
        int potions)
    {
        this.pseudo = pseudo;
        Vie = vie;
        MaxVie = vie;
        Force = force;
        Exp = exp;
        LvlCapExp = lvlCapExp;
        Lvl = lvl;
        Potions = potions;
    }

    public bool EstEnVie()
    {
        return Vie > 0;
    }

    public void SubirDegats(int degats)
    {
        Vie -= degats;

        if (Vie < 0)
            Vie = 0;
    }

    public void GagnerExp(int experience)
    {
        Exp += experience;

        while (Exp >= LvlCapExp)
        {
            Exp -= LvlCapExp;
            LvlUp();
        }
    }

    public void LvlUp()
    {
        Lvl++;
        Force++;
        MaxVie += 2;
        LvlCapExp += 10;
        Vie = MaxVie;
    }
}

